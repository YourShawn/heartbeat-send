# Copy to .env and adjust. Used by docker compose and local Spring Boot.
# Never commit .env. Do not put a public IP or public DNS name for MySQL.

# --- MySQL ---
# Local processes (mvn / tests): loopback only.
# Production/server: private hostname or localhost via uncommitted .env.
# Docker Compose talking to MySQL on the same host: host.docker.internal
#   (or the host gateway). Linux Compose maps this via extra_hosts.
# Bundled demo (`docker compose --profile bundled-mysql`): mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=heartbeat_send
MYSQL_USER=heartbeat
MYSQL_PASSWORD=heartbeat
MYSQL_ROOT_PASSWORD=change-me-root

# --- Backend ---
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# OpenAI-compatible synth (optional). If empty, deterministic rules are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Public URL used when minting share links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8080

# --- Frontend (Vite dev) ---
VITE_API_BASE=
